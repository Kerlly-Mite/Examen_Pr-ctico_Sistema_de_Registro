# Copia este archivo como ".env" (en la raíz del repositorio) y ajusta los valores.
# NUNCA subas el archivo .env a GitHub.

# --- API (Go) ---
PORT=3001
# URL del frontend (se usa para armar el enlace del correo de recuperación)
FRONTEND_URL=http://localhost:5180
# Orígenes extra permitidos por CORS, separados por coma (el de Vite ya viene incluido)
# CORS_ORIGINS=https://mi-frontend.onrender.com

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=biess_user
DB_PASSWORD=biess_pass
DB_NAME=biess_postulacion
DB_SSLMODE=disable
DB_MAX_CONNS=10
# Si se define, tiene prioridad sobre DB_* (útil en la nube):
# DATABASE_URL=postgres://usuario:clave@host:5432/biess_postulacion

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6380/0
# Vigencia de la caché de catálogos (horas)
CATALOGO_TTL_HORAS=24

# --- Seguridad ---
# OBLIGATORIO. Mínimo 32 caracteres. Genera uno propio, por ejemplo con:  openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-por-uno-de-minimo-32-caracteres
# Duración de la sesión (horas)
JWT_HORAS=8
# Regla de EF-11: intentos fallidos consecutivos permitidos y minutos de bloqueo
MAX_INTENTOS=3
BLOQUEO_MINUTOS=10

# --- Correo (SMTP) ---
# Si SMTP_HOST está vacío, los correos (recuperación de contraseña y confirmación de la postulación)
# se muestran en la consola del backend. Para enviarlos de verdad con Gmail:
#   1) Active la verificación en 2 pasos de la cuenta.
#   2) Cree una "contraseña de aplicación" (Cuenta de Google > Seguridad > Contraseñas de aplicación).
#   3) Póngala en SMTP_PASSWORD (16 letras, sin espacios). NUNCA use la contraseña normal ni la suba a GitHub.
SMTP_HOST=
# 587 = STARTTLS (Gmail, Outlook) | 465 = TLS directo
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Dirección del remitente (si se deja vacía se usa SMTP_USER)
SMTP_FROM=
SMTP_FROM_NAME=Postulación Directorio BIESS

# --- Documentos PDF ---
# Carpeta donde se guardan los PDF subidos (relativa a backend/)
UPLOADS_DIR=uploads

# --- Solo producción (docker-compose.prod.yml) ---
# Dominio público que usa Caddy para el certificado HTTPS (por ejemplo 203-0-113-10.sslip.io)
DOMINIO=

# Copia este archivo como ".env" (en la raíz del repositorio) y ajusta los valores.
# NUNCA subas el archivo .env a GitHub.

# --- API (Go) ---
PORT=3000
# Orígenes extra permitidos por CORS, separados por coma (el de Vite ya viene incluido)
# CORS_ORIGINS=https://mi-frontend.onrender.com

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=biess_user
DB_PASSWORD=biess_pass
DB_NAME=biess_postulacion
DB_SSLMODE=disable
DB_MAX_CONNS=10
# Si se define, tiene prioridad sobre DB_* (útil en la nube):
# DATABASE_URL=postgres://usuario:clave@host:5432/biess_postulacion

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6380/0

# --- Seguridad (se usan desde la Fase 2) ---
# Mínimo 32 caracteres. Genera uno propio, por ejemplo con:  openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-por-uno-de-minimo-32-caracteres
# Reglas del bloqueo por intentos fallidos (EF-11)
MAX_INTENTOS=3
BLOQUEO_MINUTOS=10
